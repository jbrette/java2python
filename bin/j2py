#!/usr/bin/env python3
""" j2py -> runs java2python.cli from a source checkout.

Installed copies get a `j2py` console script instead; see pyproject.toml.
"""
import sys
from os import path

sys.path.insert(0, path.dirname(path.dirname(path.abspath(__file__))))

from java2python.cli import main

sys.exit(main())
